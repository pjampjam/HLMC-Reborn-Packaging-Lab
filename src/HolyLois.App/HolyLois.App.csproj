<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><AssemblyName>HolyLoisReborn</AssemblyName><ApplicationIcon>../../assets/app.ico</ApplicationIcon><Version>1.4.0</Version><Company>pjampjam</Company><Product>Holy Lois: Reborn</Product><Copyright>pjampjam - Holy Lois contributors</Copyright><HolyLoisPreview Condition="'$(HolyLoisPreview)' == ''">true</HolyLoisPreview></PropertyGroup>
  <PropertyGroup><PackAssetRoot Condition="'$(PackAssetRoot)' == ''">../../assets</PackAssetRoot></PropertyGroup>
  <ItemGroup><AssemblyMetadata Include="HolyLoisPreview" Value="$(HolyLoisPreview)"/></ItemGroup>
  <ItemGroup><Compile Remove="OwnerPublishing.cs;OwnerWindow.cs"/></ItemGroup>
  <ItemGroup><Resource Include="Brand/compact.png" Link="Assets/compact.png"/><Resource Include="Brand/pics/*.jpg" Link="Assets/pics/%(Filename)%(Extension)"/><ProjectReference Include="../HolyLois.Core/HolyLois.Core.csproj"/><Resource Include="../../assets/logo.png" Link="Assets/logo.png"/><Resource Include="../../assets/premium-launcher.jpeg" Link="Assets/premium-launcher.jpeg"/><EmbeddedResource Include="../../assets/release-public.pem;../../assets/app-release-public.pem;../../assets/fabric-profile.json;../../assets/vanilla-profile.json;../../assets/server-icon.png;../../assets/profile-icon.png;../../assets/strings.json" Link="Assets/%(Filename)%(Extension)"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="$(PackAssetRoot)/pack.json;$(PackAssetRoot)/pack.json.sig;$(PackAssetRoot)/defaults.zip" Link="Assets/%(Filename)%(Extension)"/></ItemGroup>
</Project>
