<Application xmlns:local="clr-namespace:HolyLois.App" x:Class="HolyLois.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources>
<!-- Holy Lois color system 1.3. Surfaces step up in lightness: Canvas < Surface < SurfaceRaised < Control < ControlHover.
     Gold is the brand and continue accent, green means play or active progress, red means destructive or failed.
     Text pairs (On*) keep at least 4.5:1 contrast on their fills. Labels always name the action, so color is never the only cue. -->
<Color x:Key="CanvasColor">#111215</Color>
<Color x:Key="SurfaceColor">#18191C</Color>
<Color x:Key="SurfaceRaisedColor">#202226</Color>
<Color x:Key="ControlColor">#282A2F</Color>
<Color x:Key="ControlHoverColor">#32353B</Color>
<Color x:Key="LineColor">#3A3D44</Color>
<Color x:Key="LineStrongColor">#5E626C</Color>
<Color x:Key="TextColor">#F3F0E8</Color>
<Color x:Key="MutedColor">#ADA99F</Color>
<Color x:Key="GoldColor">#FFE24D</Color>
<Color x:Key="GoldSoftColor">#3A3220</Color>
<Color x:Key="OnGoldColor">#1A1500</Color>
<Color x:Key="ActionGreenColor">#2BC46E</Color>
<Color x:Key="PlayGreenColor">#27BE68</Color>
<Color x:Key="PlayTopColor">#45DB87</Color>
<Color x:Key="PlayBottomColor">#1FA95A</Color>
<Color x:Key="PlayLipColor">#11703A</Color>
<Color x:Key="OnGreenColor">#04210F</Color>
<Color x:Key="DangerFillColor">#C2362F</Color>
<Color x:Key="DangerColor">#FF928A</Color>
<Color x:Key="SuccessColor">#7ED3A0</Color>
<SolidColorBrush x:Key="Canvas" Color="{StaticResource CanvasColor}"/>
<SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
<SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}"/>
<SolidColorBrush x:Key="Control" Color="{StaticResource ControlColor}"/>
<SolidColorBrush x:Key="ControlHover" Color="{StaticResource ControlHoverColor}"/>
<SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
<SolidColorBrush x:Key="LineStrong" Color="{StaticResource LineStrongColor}"/>
<SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
<SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
<SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}"/>
<SolidColorBrush x:Key="GoldSoft" Color="{StaticResource GoldSoftColor}"/>
<SolidColorBrush x:Key="OnGold" Color="{StaticResource OnGoldColor}"/>
<SolidColorBrush x:Key="ActionGreen" Color="{StaticResource ActionGreenColor}"/>
<SolidColorBrush x:Key="PlayGreen" Color="{StaticResource PlayGreenColor}"/>
<LinearGradientBrush x:Key="PlayFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{StaticResource PlayTopColor}" Offset="0"/><GradientStop Color="{StaticResource PlayBottomColor}" Offset="1"/></LinearGradientBrush>
<SolidColorBrush x:Key="PlayLip" Color="{StaticResource PlayLipColor}"/>
<SolidColorBrush x:Key="OnGreen" Color="{StaticResource OnGreenColor}"/>
<SolidColorBrush x:Key="DangerFill" Color="{StaticResource DangerFillColor}"/>
<SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
<SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
<CornerRadius x:Key="Radius">8</CornerRadius>
<CornerRadius x:Key="InnerRadius">6</CornerRadius>

<Style x:Key="LauncherPicture" TargetType="Border"><Setter Property="Height" Value="155"/><Setter Property="CornerRadius" Value="{StaticResource InnerRadius}"/><Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/></Style>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
<!-- One button shape for every action. Hover and press use neutral washes over any fill, so each variant keeps its color and contrast. -->
<Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="{StaticResource Control}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}"/><Border x:Name="Wash" Background="#FFFFFF" Opacity="0" CornerRadius="{StaticResource Radius}" IsHitTestVisible="False"/><Border Padding="{TemplateBinding Padding}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><Border x:Name="FocusRing" BorderBrush="{StaticResource Gold}" BorderThickness="2" Margin="2" CornerRadius="{StaticResource InnerRadius}" Visibility="Collapsed" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineStrong}"/><Setter TargetName="Wash" Property="Opacity" Value="0.07"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:InputModality.KeyboardFocusVisible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></MultiTrigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Wash" Property="Background" Value="#000000"/><Setter TargetName="Wash" Property="Opacity" Value="0.16"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

<Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="{StaticResource OnGold}"/><Setter Property="BorderBrush" Value="{StaticResource Gold}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="12"/></Style>
<Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource ActionGreen}"/><Setter Property="Foreground" Value="{StaticResource OnGreen}"/><Setter Property="BorderBrush" Value="{StaticResource ActionGreen}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<!-- Play is the one game-like button: a soft green face on a darker lip that presses down, like a block being pushed. Dark text keeps over 5.9:1 contrast on the whole gradient. -->
<Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource SuccessButton}"><Setter Property="Background" Value="{StaticResource PlayFill}"/><Setter Property="BorderBrush" Value="{StaticResource PlayLip}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid>
<Border x:Name="Lip" Background="{StaticResource PlayLip}" CornerRadius="10" Margin="0,4,0,0"/>
<Grid x:Name="Face" Margin="0,0,0,4">
<Border Background="{TemplateBinding Background}" CornerRadius="10"/>
<Border CornerRadius="10" BorderThickness="0,1,0,0" BorderBrush="#5CFFFFFF" IsHitTestVisible="False"/>
<Border x:Name="Wash" Background="#FFFFFF" Opacity="0" CornerRadius="10" IsHitTestVisible="False"/>
<Border Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
<Border x:Name="FocusRing" BorderBrush="{StaticResource Gold}" BorderThickness="2" Margin="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
</Grid></Grid>
<ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.10"/></Trigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:InputModality.KeyboardFocusVisible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></MultiTrigger>
<Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Margin" Value="0,3,0,1"/><Setter TargetName="Wash" Property="Background" Value="#000000"/><Setter TargetName="Wash" Property="Opacity" Value="0.08"/></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.42"/><Setter TargetName="Lip" Property="Opacity" Value="0.42"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource DangerFill}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource DangerFill}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Danger}"/><Setter Property="BorderBrush" Value="#6B403C"/></Style>
<Style TargetType="ComboBox"><Setter Property="Background" Value="{StaticResource Control}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="12,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius}"/><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path Data="M 0,0 L 4,4 L 8,0" Width="8" Height="4" Stroke="{StaticResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,30,0" IsHitTestVisible="False"/><Border x:Name="FocusRing" BorderBrush="{StaticResource Gold}" BorderThickness="2" Margin="2" CornerRadius="{StaticResource InnerRadius}" Visibility="Collapsed" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="4" MinWidth="140"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource LineStrong}"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:InputModality.KeyboardFocusVisible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource InnerRadius}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource GoldSoft}"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ControlHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{StaticResource LineStrong}" CornerRadius="3" Margin="3,1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#7F8490"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="Expander">
<Setter Property="Background" Value="{StaticResource SurfaceRaised}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}" Padding="{TemplateBinding Padding}"><StackPanel>
<ToggleButton Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" FocusVisualStyle="{x:Null}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
<ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Arrow" Text="+" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/><Border x:Name="HeaderFocus" Grid.ColumnSpan="2" CornerRadius="{StaticResource InnerRadius}" BorderThickness="2" BorderBrush="{StaticResource Gold}" Visibility="Collapsed" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="-"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:InputModality.KeyboardFocusVisible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="HeaderFocus" Property="Visibility" Value="Visible"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
</ToggleButton><ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" local:UiMotion.FadeOnReveal="True"/></StackPanel></Border>
<ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource Canvas}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="{StaticResource Gold}"/><Setter Property="SelectionBrush" Value="{StaticResource Gold}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Field" CornerRadius="{StaticResource Radius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="ProgressBar"><Setter Property="Background" Value="{StaticResource Line}"/><Setter Property="Foreground" Value="{StaticResource ActionGreen}"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Ellipse x:Name="Ring" Width="16" Height="16" Stroke="{StaticResource Muted}" StrokeThickness="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,2,0,0"/><Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Gold}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6,0,0" Visibility="Collapsed"/>
<ContentPresenter Grid.Column="1"/><Border x:Name="RadioFocus" Grid.ColumnSpan="2" CornerRadius="{StaticResource InnerRadius}" BorderThickness="2" BorderBrush="{StaticResource Gold}" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
<ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Gold}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="local:InputModality.KeyboardFocusVisible" Value="True"/></MultiTrigger.Conditions><Setter TargetName="RadioFocus" Property="Visibility" Value="Visible"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Application.Resources></Application>
