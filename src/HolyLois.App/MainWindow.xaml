<local:ThemedWindow xmlns:local="clr-namespace:HolyLois.App" x:Class="HolyLois.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Holy Lois: Reborn" Width="1060" Height="780" MinWidth="920" MinHeight="650" Background="{StaticResource Surface}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition/></Grid.ColumnDefinitions>
<!-- Left rail: who we are and the one action that matters now (Install, Update, Repair or Play). It never scrolls away. -->
<Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid Margin="24,30,24,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel HorizontalAlignment="Center" Width="200">
<Image Source="Assets/logo.png" Width="150" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Holy Lois crown logo"/>
<TextBlock Text="REBORN" FontFamily="Impact" FontSize="26" TextAlignment="Center" Margin="0,12,0,0"/>
<Button x:Name="PrimaryAction" Click="Primary_Click" Margin="0,26,0,0" MinHeight="68" Padding="12,12" BorderThickness="1" AutomationProperties.Name="{Binding Text, ElementName=PrimaryLabel}"><StackPanel><TextBlock x:Name="PrimaryLabel" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="PrimarySub" FontSize="11" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel></Button>
<TextBlock x:Name="PrimaryHint" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel>
<StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource L.Address}" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Center"/><StackPanel x:Name="ServerBadge" Background="Transparent" Margin="0,7,0,10" HorizontalAlignment="Center" ToolTipService.InitialShowDelay="150" AutomationProperties.Name="Server status"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="AddressText" Text="play.holylois.com" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="ServerStateText" Text="{DynamicResource L.ServerChecking}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel><Button Content="{DynamicResource L.Copy}" Click="CopyAddress_Click" Padding="12,8" FontSize="12"/><UniformGrid x:Name="LinkGrid" Columns="2" Margin="0,8,0,0"><Button x:Name="DiscordButton" Content="Discord" Click="Discord_Click" Padding="8,7" FontSize="12" Margin="0,0,4,0" AutomationProperties.Name="Open the Holy Lois Discord"/><Button x:Name="WebsiteButton" Content="{DynamicResource L.Website}" Click="Website_Click" Padding="8,7" FontSize="12" Margin="4,0,0,0"/></UniformGrid><TextBlock x:Name="AppVersion" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,0" TextAlignment="Center"/></StackPanel>
</Grid></Border>
<ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,26,28,28">
<!-- Header: greeting and version line, language and Settings. -->
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock x:Name="HeaderTitle" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ReleaseLabel" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
<ComboBox x:Name="LanguageChoice" Grid.Column="1" Width="135" Height="36" VerticalAlignment="Top" SelectionChanged="Language_Changed" AutomationProperties.Name="Language"><ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Latviešu" Tag="lv"/></ComboBox>
<Button x:Name="SettingsButton" Grid.Column="2" Content="{DynamicResource L.Settings}" Click="Settings_Click" Margin="10,0,0,0" FontSize="12" Padding="12,6" MinHeight="36" VerticalAlignment="Top"/></Grid>
<!-- Readiness: what state the pack is in, what the last action did, progress while working. -->
<Border x:Name="StatusCard" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16" Margin="0,22,0,0"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PackStatus" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="StateHint" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"><Button x:Name="CheckUpdatesButton" Content="{DynamicResource L.Check}" Click="CheckUpdates_Click" FontSize="12" Padding="12,7"/><Button x:Name="VerifyButton" Content="{DynamicResource L.CheckFiles}" Click="Verify_Click" FontSize="12" Padding="12,7" Margin="8,0,0,0"/></StackPanel></Grid>
<TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/>
<StackPanel x:Name="WorkPanel" Visibility="Collapsed" Margin="0,12,0,0"><ProgressBar x:Name="Progress" AutomationProperties.Name="Pack download and installation progress" Minimum="0" Maximum="100" Height="7"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ProgressDetails" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource CancelButton}" Content="{DynamicResource L.Cancel}" Click="Cancel_Click" FontSize="12" Padding="12,6"/></Grid></StackPanel>
<TextBlock x:Name="UpdateStatus" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
</StackPanel></Border>
<!-- Account: a compact summary for returning players; the two ways to play only open on request. -->
<Border x:Name="AccountCard" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16" Margin="0,14,0,0"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border x:Name="HeadFrame" Width="52" Height="52" CornerRadius="{StaticResource InnerRadius}" Background="{StaticResource Control}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center"><Grid><Image x:Name="HeadImage" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor"/><Image x:Name="HeadFallback" Source="Assets/compact.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="AccountEyebrow" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AccountTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AccountMode" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal"><Button x:Name="ChangeNameButton" Content="{DynamicResource L.NameChange}" Click="ChangeName_Click" FontSize="12" Padding="12,7"/><Button x:Name="ModeButton" Content="{DynamicResource L.ModeChange}" Click="Mode_Click" FontSize="12" Padding="12,7" Margin="8,0,0,0"/></StackPanel></Grid>
<StackPanel x:Name="NameEntry" Margin="0,14,0,0"><TextBlock Text="{DynamicResource L.NameChoose}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.NameRules}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NameBox" MaxLength="16" FontSize="14" Padding="10,8" AutomationProperties.Name="{DynamicResource L.NameChoose}" KeyDown="NameBox_KeyDown"/><Button x:Name="NameSaveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource L.NameSave}" Click="SaveName_Click" Margin="8,0,0,0" Padding="14,8"/></Grid></StackPanel>
<TextBlock x:Name="NameNote" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
<StackPanel x:Name="LauncherPanel" Margin="0,14,0,0">
<Border x:Name="DetectionPanel" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource InnerRadius}" Padding="12,10"><TextBlock x:Name="DetectionHint" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border>
<WrapPanel x:Name="LauncherActions" Margin="0,10,0,0"><Button Content="{DynamicResource L.Locate}" Click="Locate_Click" Padding="12,8" FontSize="12"/><Button Content="{DynamicResource L.Download}" Click="GetLauncher_Click" Padding="12,8" FontSize="12" Margin="8,0,0,0"/></WrapPanel>
<Button x:Name="LinkSkButton" Content="{DynamicResource L.Link}" Click="LinkSk_Click" HorizontalAlignment="Left" Padding="12,8" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
<Button x:Name="RebuildSkButton" Content="{DynamicResource L.RebuildSk}" Click="RebuildSk_Click" HorizontalAlignment="Left" FontSize="12" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed"/>
</StackPanel>
<TextBlock x:Name="LauncherHint" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
<StackPanel x:Name="ModeChooser" Margin="0,16,0,0" Visibility="Collapsed"><TextBlock Text="{DynamicResource L.SetupChoose}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button x:Name="OfficialCard" AutomationProperties.Name="{DynamicResource L.AccountCard}" Click="Official_Click" Padding="16,14" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="{DynamicResource L.AccountCard}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.Premium}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="OfficialSelected" Text="{DynamicResource L.Selected}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,10,0,0"/></StackPanel></Button>
<Button x:Name="SkCard" AutomationProperties.Name="{DynamicResource L.NameCard}" Grid.Column="2" Click="Sk_Click" Padding="16,14" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="{DynamicResource L.NameCard}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.Offline}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="SkSelected" Text="{DynamicResource L.Selected}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,10,0,0"/></StackPanel></Button>
</Grid></StackPanel>
</StackPanel></Border>
<!-- News: the newest release in three bullets; the full history stays one click away. -->
<Border x:Name="NewsCard" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="18,16" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.Name="Latest update"><StackPanel><TextBlock x:Name="NewsEyebrow" FontSize="12" Foreground="{StaticResource Gold}"/><TextBlock x:Name="NewsTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/><StackPanel x:Name="NewsHighlights" Margin="0,8,0,0"/><Button x:Name="AllChangesButton" Content="{DynamicResource L.AllChanges}" Click="AllChanges_Click" HorizontalAlignment="Left" FontSize="12" Padding="12,7" Margin="0,12,0,0"/></StackPanel></Border>
<Expander x:Name="HelpExpander" Header="{DynamicResource L.Help}" Margin="0,22,0,0"><TextBlock Text="{DynamicResource L.HelpText}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,8"/></Expander>
<Expander x:Name="HistoryExpander" Header="{DynamicResource L.History}" Margin="0,16,0,0"><StackPanel x:Name="HistoryPanel" Margin="0,12,0,0"/></Expander>
</StackPanel></ScrollViewer>
</Grid></local:ThemedWindow>
