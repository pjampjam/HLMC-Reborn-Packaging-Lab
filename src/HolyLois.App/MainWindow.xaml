<local:ThemedWindow xmlns:local="clr-namespace:HolyLois.App" x:Class="HolyLois.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Holy Lois: Reborn" Width="1060" Height="780" MinWidth="920" MinHeight="650" Background="{StaticResource Surface}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid Margin="24,32,24,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel HorizontalAlignment="Center" Width="184"><Image Source="Assets/logo.png" Width="164" Height="164" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Holy Lois crown logo"/><TextBlock Text="HOLY LOIS" FontFamily="Franklin Gothic Medium" FontSize="25" TextAlignment="Center" Margin="0,18,0,0"/><TextBlock Text="REBORN" FontFamily="Impact" FontSize="38" TextAlignment="Center" Margin="0,0,0,0"/><Button x:Name="PlayButton" Click="Play_Click" Margin="0,24,0,0" MinHeight="64" Padding="12,14" FontWeight="SemiBold" BorderThickness="1"><StackPanel><TextBlock x:Name="PlayLabel" Text="{DynamicResource L.Play}" FontSize="20" TextAlignment="Center"/><TextBlock x:Name="PlayLauncherLabel" FontSize="11" FontWeight="Normal" Margin="0,5,0,0" TextAlignment="Center"/></StackPanel></Button><TextBlock x:Name="PlayHint" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel>
<StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource L.Address}" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Center"/><TextBlock Text="79.76.40.155:25565" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Gold}" Margin="0,7,0,10" TextAlignment="Center"/><Button Content="{DynamicResource L.Copy}" Click="CopyAddress_Click" Padding="12,9"/><TextBlock x:Name="AppVersion" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,24,0,0" TextAlignment="Center"/></StackPanel>
</Grid></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,26,28,28">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource L.PlayTitle}" FontSize="28" FontWeight="SemiBold"/><ComboBox x:Name="LanguageChoice" Grid.Column="1" Width="135" Height="36" SelectionChanged="Language_Changed" AutomationProperties.Name="Language"><ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Latviešu" Tag="lv"/></ComboBox><Button x:Name="SettingsButton" Grid.Column="2" Content="{DynamicResource L.Settings}" Click="Settings_Click" Margin="10,0,0,0" FontSize="12" Padding="12,6" MinHeight="36"/></Grid>
<TextBlock x:Name="ReleaseLabel" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,10"/>
<WrapPanel Margin="0,0,0,20"><Button x:Name="CheckUpdatesButton" Content="{DynamicResource L.Check}" Click="CheckUpdates_Click" FontSize="12" Padding="12,7"/><TextBlock x:Name="UpdateStatus" FontSize="12" MaxWidth="340" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/></WrapPanel>
<TextBlock Text="{DynamicResource L.YourLauncher}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button x:Name="OfficialCard" AutomationProperties.Name="Minecraft Launcher" Click="Official_Click" Padding="16,14" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="Minecraft Launcher" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.Premium}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock x:Name="OfficialSelected" Text="{DynamicResource L.Selected}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,12,0,0"/></StackPanel></Button>
<Button x:Name="SkCard" AutomationProperties.Name="SKlauncher" Grid.Column="2" Click="Sk_Click" Padding="16,14" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="SKlauncher" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.Offline}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock x:Name="SkSelected" Text="{DynamicResource L.Selected}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,12,0,0"/></StackPanel></Button>
</Grid>
<Border x:Name="DetectionPanel" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="12,10" Margin="0,12,0,0"><TextBlock x:Name="DetectionHint" FontSize="12" Foreground="{StaticResource Muted}"/></Border>
<WrapPanel x:Name="LauncherActions" Margin="0,10,0,0"><Button Content="{DynamicResource L.Locate}" Click="Locate_Click" Padding="12,8" FontSize="12"/><Button Content="{DynamicResource L.Download}" Click="GetLauncher_Click" Padding="12,8" FontSize="12" Margin="8,0,0,0"/></WrapPanel>
<TextBlock x:Name="LauncherHint" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
<Button x:Name="LinkSkButton" Content="{DynamicResource L.Link}" Click="LinkSk_Click" HorizontalAlignment="Left" Padding="12,8" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
<Button x:Name="RebuildSkButton" Content="{DynamicResource L.RebuildSk}" Click="RebuildSk_Click" HorizontalAlignment="Left" FontSize="12" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed"/>
<Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,18,0,0"><StackPanel>
<TextBlock x:Name="PackStatus" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SizeLabel" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
<TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" FontSize="13" Margin="0,14,0,12"/>
<ProgressBar x:Name="Progress" AutomationProperties.Name="Pack download and installation progress" Minimum="0" Maximum="100" Height="7" Margin="0,0,0,14"/>
<TextBlock x:Name="ProgressDetails" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12" Visibility="Collapsed"/><WrapPanel><Button x:Name="InstallButton" Click="Install_Click" FontWeight="SemiBold" MinWidth="190" MinHeight="48"><TextBlock x:Name="InstallLabel"/></Button><Button x:Name="CancelButton" Style="{StaticResource CancelButton}" Content="{DynamicResource L.Cancel}" Click="Cancel_Click" Visibility="Collapsed" Margin="10,8,0,0"/></WrapPanel>
</StackPanel></Border>
<TextBlock Text="{DynamicResource L.ShaderHint}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,10"/>
<WrapPanel><Button Content="{DynamicResource L.ShaderOff}" Click="DisableShaders_Click" FontSize="12" Padding="12,8"/><Button Content="{DynamicResource L.Folder}" Click="GameFolder_Click" FontSize="12" Padding="12,8" Margin="8,0,0,0"/></WrapPanel>
<Expander Header="{DynamicResource L.Help}" Margin="0,22,0,0"><TextBlock Text="{DynamicResource L.HelpText}" FontSize="13" Margin="0,12,0,8"/></Expander>
<Expander Header="{DynamicResource L.History}" Margin="0,16,0,0"><StackPanel x:Name="HistoryPanel" Margin="0,12,0,0"/></Expander>
</StackPanel></ScrollViewer>
</Grid></local:ThemedWindow>
