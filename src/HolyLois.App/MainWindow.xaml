<local:ThemedWindow xmlns:local="clr-namespace:HolyLois.App" x:Class="HolyLois.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Holy Lois: Reborn" Width="1060" Height="780" MinWidth="920" MinHeight="650" Background="{StaticResource Surface}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition/></Grid.ColumnDefinitions>
<!-- Left rail: who we are, the one action that matters now (Install, Update, Repair or Play) and its feedback right beneath it. -->
<Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid Margin="24,26,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel HorizontalAlignment="Center" Width="200">
<Image x:Name="Logo" Source="Assets/logo.png" Width="140" Height="140" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Holy Lois crown logo"/>
<TextBlock Text="REBORN" FontFamily="Impact" FontSize="26" TextAlignment="Center" Margin="0,10,0,0"/>
<Button x:Name="PrimaryAction" Click="Primary_Click" Margin="0,22,0,0" MinHeight="68" Padding="12,12" BorderThickness="1" AutomationProperties.Name="{Binding Text, ElementName=PrimaryLabel}"><StackPanel><TextBlock x:Name="PrimaryLabel" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="PrimarySub" FontSize="11" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel></Button>
<TextBlock x:Name="PrimaryHint" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
<StackPanel x:Name="WorkPanel" Visibility="Collapsed" Margin="0,12,0,0"><ProgressBar x:Name="Progress" AutomationProperties.Name="Pack download and installation progress" Minimum="0" Maximum="100" Height="6"/><TextBlock x:Name="ProgressDetails" FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/><Button x:Name="CancelButton" Style="{StaticResource CancelButton}" Content="{DynamicResource L.Cancel}" Click="Cancel_Click" FontSize="12" Padding="12,4" MinHeight="30" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
<TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
<WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0"><Button x:Name="CheckUpdatesButton" Style="{StaticResource LinkButton}" Content="{DynamicResource L.Check}" Click="CheckUpdates_Click"/><Button x:Name="VerifyButton" Style="{StaticResource LinkButton}" Content="{DynamicResource L.CheckFiles}" Click="Verify_Click"/></WrapPanel>
<TextBlock x:Name="UpdateStatus" FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
</StackPanel>
<StackPanel Grid.Row="2"><StackPanel x:Name="ServerBadge" Background="Transparent" Margin="0,0,0,10" HorizontalAlignment="Center" ToolTipService.InitialShowDelay="150" AutomationProperties.Name="Server status"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="AddressText" Text="play.holylois.com" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Text}" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="ServerStateText" Text="{DynamicResource L.ServerChecking}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel><Button Content="{DynamicResource L.Copy}" Click="CopyAddress_Click" Padding="6,7" FontSize="12" Margin="0,0,0,6"/><UniformGrid x:Name="LinkGrid" Columns="2"><Button x:Name="DiscordButton" Content="Discord" Click="Discord_Click" Padding="6,7" FontSize="12" Margin="2,0,2,0" AutomationProperties.Name="Open the Holy Lois Discord"/><Button x:Name="WebsiteButton" Content="{DynamicResource L.Website}" Click="Website_Click" Padding="6,7" FontSize="12" Margin="3,0,0,0"/></UniformGrid><TextBlock x:Name="AppVersion" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextAlignment="Center"/></StackPanel>
</Grid></Border>
<ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,26,32,28">
<!-- Header: greeting and version line, language and Settings. -->
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock x:Name="HeaderTitle" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ReleaseLabel" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
<ComboBox x:Name="LanguageChoice" Grid.Column="1" Width="135" Height="36" VerticalAlignment="Top" SelectionChanged="Language_Changed" AutomationProperties.Name="Language"><ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Latviešu" Tag="lv"/></ComboBox>
<Button x:Name="SettingsButton" Grid.Column="2" Content="{DynamicResource L.Settings}" Click="Settings_Click" Margin="8,0,0,0" FontSize="12" Padding="12,6" MinHeight="36" VerticalAlignment="Top"/></Grid>
<!-- Account: who plays and how. The two ways to play open only on request. -->
<Border x:Name="AccountCard" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="16" Margin="0,20,0,0"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border x:Name="HeadFrame" Width="48" Height="48" CornerRadius="{StaticResource InnerRadius}" Background="{StaticResource Control}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center"><Grid><Image x:Name="HeadImage" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor"/><Image x:Name="HeadFallback" Source="Assets/compact.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="AccountEyebrow" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AccountTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AccountMode" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal"><Button x:Name="ChangeNameButton" Content="{DynamicResource L.NameChange}" Click="ChangeName_Click" FontSize="12" Padding="12,6" MinHeight="34"/><Button x:Name="ModeButton" Content="{DynamicResource L.ModeChange}" Click="Mode_Click" FontSize="12" Padding="12,6" MinHeight="34" Margin="8,0,0,0"/></StackPanel></Grid>
<StackPanel x:Name="NameEntry" Margin="0,14,0,0"><TextBlock Text="{DynamicResource L.NameChoose}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.NameRules}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NameBox" MaxLength="16" FontSize="14" Padding="10,8" AutomationProperties.Name="{DynamicResource L.NameChoose}" KeyDown="NameBox_KeyDown"/><Button x:Name="NameSaveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource L.NameSave}" Click="SaveName_Click" Margin="8,0,0,0" Padding="14,8"/></Grid></StackPanel>
<TextBlock x:Name="NameNote" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
<StackPanel x:Name="LauncherPanel" Margin="0,12,0,0">
<Border x:Name="DetectionPanel" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource InnerRadius}" Padding="12,8"><TextBlock x:Name="DetectionHint" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border>
<WrapPanel x:Name="LauncherActions" Margin="0,8,0,0"><Button Content="{DynamicResource L.Locate}" Click="Locate_Click" Padding="12,6" MinHeight="34" FontSize="12"/><Button Content="{DynamicResource L.Download}" Click="GetLauncher_Click" Padding="12,6" MinHeight="34" FontSize="12" Margin="8,0,0,0"/></WrapPanel>
<Button x:Name="LinkSkButton" Content="{DynamicResource L.Link}" Click="LinkSk_Click" HorizontalAlignment="Left" Padding="12,6" MinHeight="34" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
<Button x:Name="RebuildSkButton" Content="{DynamicResource L.RebuildSk}" Click="RebuildSk_Click" HorizontalAlignment="Left" FontSize="12" Padding="12,6" MinHeight="34" Margin="0,8,0,0" Visibility="Collapsed"/>
</StackPanel>
<TextBlock x:Name="LauncherHint" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="62,8,0,0"/>
<StackPanel x:Name="ModeChooser" Margin="0,14,0,0" Visibility="Collapsed"><TextBlock Text="{DynamicResource L.SetupChoose}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button x:Name="OfficialCard" AutomationProperties.Name="{DynamicResource L.AccountCard}" Click="Official_Click" Padding="14,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"><StackPanel><TextBlock Text="{DynamicResource L.AccountCard}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.Premium}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="OfficialSelected" Text="{DynamicResource L.Selected}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,8,0,0"/></StackPanel></Button>
<Button x:Name="SkCard" AutomationProperties.Name="{DynamicResource L.NameCard}" Grid.Column="2" Click="Sk_Click" Padding="14,12" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"><StackPanel><TextBlock Text="{DynamicResource L.NameCard}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.Offline}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="SkSelected" Text="{DynamicResource L.Selected}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,8,0,0"/></StackPanel></Button>
</Grid></StackPanel>
</StackPanel></Border>
<!-- News: a server screenshot next to the newest release in three bullets; the full history is one click away. -->
<Border x:Name="NewsCard" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Margin="0,16,0,0" Visibility="Collapsed" AutomationProperties.Name="Latest update" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border x:Name="NewsPicture" CornerRadius="6,0,0,6" RenderOptions.BitmapScalingMode="HighQuality"/>
<StackPanel Grid.Column="1" Margin="18,14,16,14"><TextBlock x:Name="NewsEyebrow" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="NewsTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/><StackPanel x:Name="NewsHighlights" Margin="0,6,0,0"/><Button x:Name="AllChangesButton" Style="{StaticResource LinkButton}" Content="{DynamicResource L.AllChanges}" Click="AllChanges_Click" HorizontalAlignment="Left" Margin="-8,6,0,0"/></StackPanel></Grid></Border>
<!-- Quick reference: the keys and commands players ask about most, from the shipped key binds and the player guide. -->
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border x:Name="QuickKeys" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="14,12"/>
<Border x:Name="QuickCommands" Grid.Column="2" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="14,12"/>
<Border x:Name="QuickLand" Grid.Column="4" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="14,12"/>
</Grid>
<Expander x:Name="HelpExpander" Header="{DynamicResource L.Help}" Margin="0,16,0,0"><StackPanel><TextBlock Text="{DynamicResource L.HelpText}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,4"/><Button Style="{StaticResource LinkButton}" Content="{DynamicResource L.FullGuide}" Click="Guide_Click" HorizontalAlignment="Left" Margin="-8,0,0,4"/></StackPanel></Expander>
<Expander x:Name="HistoryExpander" Header="{DynamicResource L.History}" Margin="0,12,0,0"><StackPanel x:Name="HistoryPanel" Margin="0,12,0,0"/></Expander>
</StackPanel></ScrollViewer>
</Grid></local:ThemedWindow>
