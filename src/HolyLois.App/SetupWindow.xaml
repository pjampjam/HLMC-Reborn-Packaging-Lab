<local:ThemedWindow xmlns:local="clr-namespace:HolyLois.App" x:Class="HolyLois.App.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Holy Lois: Reborn - Welcome" Width="780" Height="780" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Surface}" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="34,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <Grid><Image Source="Assets/logo.png" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Left"/><ComboBox x:Name="LanguageChoice" Width="130" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="Language_Changed" AutomationProperties.Name="Language"><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="ru" Content="Русский"/><ComboBoxItem Tag="lv" Content="Latviešu"/></ComboBox></Grid>
   <TextBlock Text="Holy Lois: Reborn" FontSize="30" FontWeight="SemiBold" Margin="0,16,0,6"/>
   <TextBlock Text="{DynamicResource L.SetupIntro}" Foreground="{StaticResource Muted}"/>
  </StackPanel>
  <ScrollViewer x:Name="SetupScroll" Grid.Row="1" Margin="0,24,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,0,12,0">
  <StackPanel>
   <TextBlock Text="{DynamicResource L.SetupChoose}" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="OfficialCard" AutomationProperties.Name="{DynamicResource L.AccountCard}" Click="Official_Click" Padding="14" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"><StackPanel><Border Style="{StaticResource LauncherPicture}"><Border.Background><ImageBrush ImageSource="Assets/premium-launcher.jpeg" Viewbox="0.065,0.31,0.87,0.50" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background></Border><TextBlock Text="{DynamicResource L.AccountCard}" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="{DynamicResource L.Premium}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OfficialSelected" Text="{DynamicResource L.Selected}" Foreground="{StaticResource Gold}" Margin="0,8,0,0"/></StackPanel></Button>
    <Button x:Name="SkCard" AutomationProperties.Name="{DynamicResource L.NameCard}" Grid.Column="1" Click="Sk_Click" Padding="14" Margin="6,0,0,0" HorizontalContentAlignment="Stretch"><StackPanel><Border x:Name="NamePicture" Style="{StaticResource LauncherPicture}" Background="{StaticResource Canvas}"><Grid><Image Source="Assets/logo.png" Width="104" Height="104" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><Border Background="{StaticResource Gold}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"><TextBlock Text="{DynamicResource L.FastStart}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnGold}"/></Border></Grid></Border><TextBlock Text="{DynamicResource L.NameCard}" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="{DynamicResource L.Offline}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SkSelected" Text="{DynamicResource L.Selected}" Foreground="{StaticResource Gold}" Margin="0,8,0,0"/></StackPanel></Button>
   </Grid>
   <StackPanel x:Name="SetupNamePanel" Margin="0,16,0,0" Visibility="Collapsed"><TextBlock Text="{DynamicResource L.NameChoose}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.NameRules}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,8"/><TextBox x:Name="SetupNameBox" MaxLength="16" FontSize="14" Padding="10,8" AutomationProperties.Name="{DynamicResource L.NameChoose}"/></StackPanel>
   <TextBlock Text="{DynamicResource L.SetupShortcuts}" FontWeight="SemiBold" Margin="0,22,0,8"/>
   <CheckBox x:Name="DesktopChoice" Content="{DynamicResource L.SetupDesktop}" IsChecked="True" Margin="0,0,0,10"/>
   <CheckBox x:Name="StartChoice" Content="{DynamicResource L.SetupStart}" IsChecked="True"/>
   <TextBlock Text="{DynamicResource L.SetupShortcutHint}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2"><ProgressBar x:Name="SetupProgress" Height="7" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/><TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource L.SetupNext}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,20,0" VerticalAlignment="Center"/><Button x:Name="ContinueButton" Grid.Column="1" Click="Continue_Click" Style="{StaticResource PrimaryButton}" Padding="22,12" IsDefault="True"><TextBlock Text="{DynamicResource L.SetupContinue}"/></Button></Grid></StackPanel>
 </Grid>
</local:ThemedWindow>
