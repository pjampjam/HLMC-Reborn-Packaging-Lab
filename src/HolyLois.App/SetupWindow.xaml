<local:ThemedWindow xmlns:local="clr-namespace:HolyLois.App" x:Class="HolyLois.App.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Holy Lois: Reborn - Welcome" Width="780" Height="780" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#20221F" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="34,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <Grid><Image Source="Assets/logo.png" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Left"/><ComboBox x:Name="LanguageChoice" Width="130" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="Language_Changed" AutomationProperties.Name="Language"><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="ru" Content="Русский"/><ComboBoxItem Tag="lv" Content="Latviešu"/></ComboBox></Grid>
   <TextBlock Text="Holy Lois: Reborn" FontSize="30" FontWeight="SemiBold" Margin="0,16,0,6"/>
   <TextBlock Text="{DynamicResource L.SetupIntro}" Foreground="{StaticResource Muted}"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,24,0,0">
   <TextBlock Text="{DynamicResource L.SetupChoose}" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="OfficialCard" AutomationProperties.Name="Minecraft Launcher" Click="Official_Click" Padding="14" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"><StackPanel><Border Style="{StaticResource LauncherPicture}"><Border.Background><ImageBrush ImageSource="Assets/premium-launcher.jpeg" Viewbox="0.065,0.31,0.87,0.50" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background></Border><TextBlock Text="Minecraft Launcher" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="{DynamicResource L.Premium}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="OfficialSelected" Text="{DynamicResource L.Selected}" Foreground="{StaticResource Gold}" Margin="0,8,0,0"/></StackPanel></Button>
    <Button x:Name="SkCard" AutomationProperties.Name="SKlauncher" Grid.Column="1" Click="Sk_Click" Padding="14" Margin="6,0,0,0" HorizontalContentAlignment="Stretch"><StackPanel><Border Style="{StaticResource LauncherPicture}"><Border.Background><ImageBrush ImageSource="Assets/sk-launcher.png" Viewbox="0.10,0.17,0.80,0.70" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/></Border.Background></Border><TextBlock Text="SKlauncher" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="{DynamicResource L.Offline}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SkSelected" Text="{DynamicResource L.Selected}" Foreground="{StaticResource Gold}" Margin="0,8,0,0"/></StackPanel></Button>
   </Grid>
   <TextBlock Text="{DynamicResource L.SetupShortcuts}" FontWeight="SemiBold" Margin="0,22,0,8"/>
   <CheckBox x:Name="DesktopChoice" Content="{DynamicResource L.SetupDesktop}" IsChecked="True" Foreground="#F3F3EE" Margin="0,0,0,10"/>
   <CheckBox x:Name="StartChoice" Content="{DynamicResource L.SetupStart}" IsChecked="True" Foreground="#F3F3EE"/>
   <TextBlock Text="{DynamicResource L.SetupShortcutHint}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="2"><ProgressBar x:Name="SetupProgress" Height="7" Foreground="{StaticResource ActionGreen}" Background="{StaticResource Line}" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/><TextBlock x:Name="ErrorText" Foreground="{StaticResource Gold}" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource L.SetupNext}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,20,0" VerticalAlignment="Center"/><Button x:Name="ContinueButton" Grid.Column="1" Click="Continue_Click" Background="{StaticResource Gold}" Foreground="#11120F" BorderThickness="0" Padding="22,12" IsDefault="True"><TextBlock Text="{DynamicResource L.SetupContinue}" Foreground="#11120F"/></Button></Grid></StackPanel>
 </Grid>
</local:ThemedWindow>
