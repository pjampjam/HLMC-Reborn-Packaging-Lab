<local:ThemedWindow xmlns:local="clr-namespace:HolyLois.App" x:Class="HolyLois.App.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Holy Lois: Reborn - Welcome" Width="780" Height="780" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Surface}" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="34,22,34,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Header: small mark, three step dots, language. -->
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image Source="Assets/compact.png" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
   <StackPanel x:Name="StepDots" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   <ComboBox x:Name="LanguageChoice" Grid.Column="2" Width="130" Height="36" VerticalAlignment="Center" SelectionChanged="Language_Changed" AutomationProperties.Name="Language"><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="ru" Content="Русский"/><ComboBoxItem Tag="lv" Content="Latviešu"/></ComboBox>
  </Grid>
  <ScrollViewer x:Name="SetupScroll" Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,0,12,0">
  <Grid>
   <!-- Step 1: welcome. The owner's mushroom-island cow vibing to the boombox. -->
   <StackPanel x:Name="WelcomeStep">
    <Border x:Name="WelcomePicture" Height="300" CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="{DynamicResource L.SetupWelcome}" FontSize="30" FontWeight="SemiBold" Margin="0,22,0,6" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource L.SetupIntro}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
    <TextBlock Margin="0,18,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"><Run Text="{DynamicResource L.SetupRules}"/><Run Text="  "/><Hyperlink Click="Rules_Click" Foreground="{StaticResource Gold}"><Run Text="{DynamicResource L.RulesLink}"/></Hyperlink><Run Text="  -  "/><Hyperlink Click="Privacy_Click" Foreground="{StaticResource Gold}"><Run Text="{DynamicResource L.PrivacyLink}"/></Hyperlink></TextBlock>
   </StackPanel>
   <!-- Step 2: how you play. -->
   <StackPanel x:Name="ModeStep" Visibility="Collapsed">
    <TextBlock Text="{DynamicResource L.SetupChoose}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock Text="{DynamicResource L.SetupChooseInfo}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="OfficialCard" AutomationProperties.Name="{DynamicResource L.AccountCard}" Click="Official_Click" Padding="14" Margin="0,0,6,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"><StackPanel><Border x:Name="OfficialPicture" Style="{StaticResource LauncherPicture}"/><TextBlock Text="{DynamicResource L.AccountCard}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="{DynamicResource L.Premium}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="OfficialSelected" Text="{DynamicResource L.Selected}" Foreground="{StaticResource Gold}" Margin="0,8,0,0"/></StackPanel></Button>
     <Button x:Name="SkCard" AutomationProperties.Name="{DynamicResource L.NameCard}" Grid.Column="1" Click="Sk_Click" Padding="14" Margin="6,0,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"><StackPanel><Border x:Name="NamePicture" Style="{StaticResource LauncherPicture}"><Border Background="{StaticResource Gold}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"><TextBlock Text="{DynamicResource L.FastStart}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnGold}"/></Border></Border><TextBlock Text="{DynamicResource L.NameCard}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="{DynamicResource L.Offline}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="SkSelected" Text="{DynamicResource L.Selected}" Foreground="{StaticResource Gold}" Margin="0,8,0,0"/></StackPanel></Button>
    </Grid>
    <StackPanel x:Name="SetupNamePanel" Margin="0,16,0,0" Visibility="Collapsed"><TextBlock Text="{DynamicResource L.NameChoose}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L.NameRules}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,8"/><TextBox x:Name="SetupNameBox" MaxLength="16" FontSize="14" Padding="10,8" AutomationProperties.Name="{DynamicResource L.NameChoose}"/></StackPanel>
   </StackPanel>
   <!-- Step 3: shortcuts and what happens next, over the claims map. -->
   <StackPanel x:Name="FinishStep" Visibility="Collapsed">
    <Border x:Name="FinishPicture" Height="210" CornerRadius="{StaticResource Radius}" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="{DynamicResource L.SetupFinishTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,20,0,6"/>
    <TextBlock x:Name="FinishText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource L.SetupShortcuts}" FontWeight="SemiBold" Margin="0,22,0,8"/>
    <CheckBox x:Name="DesktopChoice" Content="{DynamicResource L.SetupDesktop}" IsChecked="True" Margin="0,0,0,10"/>
    <CheckBox x:Name="StartChoice" Content="{DynamicResource L.SetupStart}" IsChecked="True"/>
    <TextBlock Text="{DynamicResource L.SetupShortcutHint}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
  </ScrollViewer>
  <StackPanel Grid.Row="2"><ProgressBar x:Name="SetupProgress" Height="7" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/><TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="BackButton" Click="Back_Click" Padding="18,11" Content="{DynamicResource L.SetupBack}"/>
    <TextBlock x:Name="StepText" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    <Button x:Name="ContinueButton" Grid.Column="2" Click="Continue_Click" Style="{StaticResource PrimaryButton}" Padding="24,12" IsDefault="True"><TextBlock x:Name="ContinueLabel"/></Button>
   </Grid></StackPanel>
 </Grid>
</local:ThemedWindow>
