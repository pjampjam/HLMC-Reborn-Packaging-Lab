  "history": [
    {
      "version": "1.7.11",
      "date": "2026-10-05",
      "summary": "Quick Play is removed: it never joined the server by itself. Play opens your Minecraft launcher, then join Holy Lois from Multiplayer.",
      "added": [],
      "removed": [
        "Quick Play (launcher 1.2.6 and Holy Lois Extras 1.5.0): in testing the game never joined by itself, so Play did the same as before. Launcher 1.2.7 drops the setting and deletes the leftover holylois-quickplay.json"
      ],
      "updated": [
        "Holy Lois Extras 1.5.1 without the Quick Play part. A real one-click start, where the launcher starts the game itself, is coming later"
      ]
    },
    {
      "version": "1.7.10",
      "date": "2026-10-05",
      "summary": "Quick Play: the launcher now sends you straight into Holy Lois. AFK time stops counting, new icons and a hidden daily code.",
      "added": [
        "Quick Play: click Play and the game joins Holy Lois by itself from the title screen, for premium and offline accounts (Settings in the launcher: Quick Play or Standard)",
        "Launcher 1.2.6: closes Minecraft and its launcher for you when an update needs it, after you press Agree",
        "/redeem CODE: a secret code of the day is hidden somewhere on holylois.com. One prize per player per day",
        "New icons for the Minecraft window and the launcher"
      ],
      "removed": [],
      "updated": [
        "AFK time no longer counts as playing: achievements, land claims, leaderboards, stats and the Tab list skip it",
        "World generation no longer overloads the server while the border grows"
      ]
    },
    {
      "version": "1.7.9",
      "date": "2026-10-05",
      "summary": "A bigger, bolder crown for the Minecraft window icon and a greener Play button in the launcher.",
      "added": [],
      "removed": [],
      "updated": [
        "The Minecraft window and taskbar icon is bigger: the crown now fills the whole icon, with wider battlements like the logo",
        "Launcher 1.2.5: a stronger green Play button and the same bigger crown icon"
      ]
    },
    {
      "version": "1.7.8",
      "date": "2026-10-04",
      "summary": "A sharp new crown icon on the game window, a server that only lets the Holy Lois pack in, and clearer dungeon achievements.",
      "added": [
        "The server checks that everyone plays the Holy Lois pack: a player with extra mods is turned away with a message that says how to fix it. Shaders, resource packs and your own settings stay yours",
        "Launcher Play button: moves extra mods out of the Holy Lois folder (kept, not deleted), repairs changed pack files and switches the pack resource packs back on"
      ],
      "removed": [],
      "updated": [
        "The Minecraft window and taskbar icon is now the Holy Lois crown, drawn pixel-perfect so it is crisp at every size",
        "New server icon in the multiplayer list",
        "Clearer achievement texts for Discoverer, Dungeon Delver, Deeper Still and Odd Pillar"
      ]
    },
    {
      "version": "1.7.7",
      "date": "2026-10-04",
      "summary": "Fixes from the 1.7.6 test: the first-person body can sink into a wall a little, a clear view in bed, dynamic lights that follow your shader setting, and a friendlier tool swap line.",
      "added": [],
      "removed": [],
      "updated": [
        "Tool swap says \"Switched to Iron Pickaxe\"",
        "First person: the body may sink into a wall a little instead of being pushed all the way forward",
        "In bed the camera is lifted a little above the pillow so your eyes are not inside your head",
        "Dynamic lights follow the shader state: with a shader pack on, the first-person light is off (the shader lights what you hold) and dropped torches and mobs still glow; with shaders off, dynamic lights are fully on, including the first-person light. If they were switched off, they are switched back on"
      ]
    },
    {
      "version": "1.7.6",
      "date": "2026-10-04",
      "summary": "Dungeon achievements, a boombox that reaches much further, tool swaps that leave your enchanted tools alone and a handful of fixes.",
      "added": [
        "Server: every dungeon (small, medium, large, obelisks) is announced when someone first finds it, with new achievements: Dungeon Delver, Deeper Still, Dungeon Master and Odd Pillar",
        "Server: dungeon chests can now drop Runeforged runes, the treasure rooms the best ones"
      ],
      "removed": [],
      "updated": [
        "Boombox: the range now goes from 16 blocks (volume 1) to 48 blocks (volume 10)",
        "A broken tool is replaced by an unenchanted spare of the same kind (lowest material first). Enchanted tools are never swapped in for you",
        "R on an empty slot sorts without also opening a recipe",
        "First person: the body steps forward when a wall is behind you and stays hidden while you sleep",
        "Torches light yellow with a shader pack on (dynamic lights pause while shaders are on and come back when they are off)",
        "Holy Lois mods now show the logo, author and links in Mod Menu",
        "Server list line shortened so it fits"
      ]
    },
    {
      "version": "1.7.5",
      "date": "2026-10-04",
      "summary": "Boombox volume and new stations, a smarter R key and tool swaps, /home picks your main home, portals that bring you back and a bigger world.",
      "added": [
        "Boombox: sneak + scroll changes the volume (1-10, louder also reaches further), music notes float while it plays, and 6 new stations: dubstep, drum and bass, trap, lo-fi, hardstyle and techno",
        "Crown window icon and the Holy Lois: Reborn window title",
        "Server: /structures tells you which structure you are standing in",
        "Server: an outdated pack gets a clear \"update in the Holy Lois launcher\" message instead of errors"
      ],
      "removed": [
        "Server: the recovery compass recipe (your death point is on the minimap)"
      ],
      "updated": [
        "R on an item shows its recipe, R on an empty slot sorts, never both",
        "A broken tool is replaced by the same kind of tool, unenchanted and most worn first, with a soft chime instead of the alarm",
        "Enchantment descriptions show only while you hold Shift",
        "No more flickering lines between glass blocks with shaders",
        "First person: the body sits a little further forward and stays out of view while you sleep",
        "The game keeps 30 FPS in the background (was 1) and the recipe list scrolls instead of using pages",
        "Clicking a command in chat (tpa accept, homes, warps) runs it right away without the confirm screen",
        "Server: with several homes, /home goes to the one named home (any capitals); names that differ only in capitals are refused, and /Home works too",
        "Server: walking back through a Nether portal takes you to the portal you came from",
        "Server: world border 20000 (10000 blocks out from the centre); the land is pre-generated while the server is empty and the web map follows the border",
        "Tab shows the player count like the server list",
        "Correction: the world map opens with J (the 1.7.4 notes said M). Claiming needs no team; name your land with ' then Player config then Claimed Area Name"
      ]
    },
    {
      "version": "1.7.4",
      "date": "2026-10-04",
      "summary": "Land and zones: claim land right on the map, see whose land you are on, and fair fights.",
      "added": [
        "Land claims on the world map (Open Parties and Claims): press M, right-click a chunk and claim it. 16 chunks free, more by playing or with coins (/claims)",
